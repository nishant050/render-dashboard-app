# ==============================================================================
# Render Dashboard & Multi-App Environment Configuration Template
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# ==============================================================================

# Server port (defaults to 3000 if unset)
PORT=3000

# Universal Master Dashboard Password (protects every app, page and API - including Finance).
# It also unlocks Jupyter, i.e. a shell on the server, so use a long random value (16+ chars).
# If not set, a random one-time password is generated and printed in the server log at startup.
DASHBOARD_PASSWORD=your_secure_master_password_here

# DietPlan Admin Password (optional override; defaults to DASHBOARD_PASSWORD if unset)
DIETPLAN_ADMIN_PASSWORD=your_dietplan_admin_password_here

# Session Secret (signs login cookies, share links and the short-lived Proxy Browser / hosted page /
# video tokens). Set it so logins and share links survive restarts; changing it revokes all of them.
# Generate a 64-char hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_session_secret_hex_here

# MongoDB Connection URI (required for FileHub GridFS, QuickNotes, Finance, LearnInvesting, DietPlan)
# Example local: mongodb://127.0.0.1:27017/render-dashboard
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/render-dashboard?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_uri_here

# Scrape.do API Key (used by NewsHunt for newspaper proxy scraping)
SCRAPE_DO_API_KEY=your_scrape_do_token_here

# AI Provider API Keys (optional - can also be configured per-user in NewsHunt / DietPlan UI)
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# YouTube Downloader / Media Tooling (optional path overrides)
YTDLP_PATH=
FFMPEG_PATH=
PYTHON_PATH=
NEWSHUNT_RETENTION_DAYS=3

# Optional security settings
# Proxy hops to trust for the client IP (login rate limiting). Defaults to 1 on Render, off locally.
TRUST_PROXY=
# Lifetime of new FileHub share links, in days (default 30).
SHARE_LINK_TTL_DAYS=30
# Jupyter access token. Leave empty to generate a random token on every start.
JUPYTER_TOKEN=
