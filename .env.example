# ==============================================================================
# Render Dashboard & Multi-App Environment Configuration Template
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# ==============================================================================

# Server port (defaults to 3000 if unset)
PORT=3000

# Universal Master Dashboard Password (protects FileHub, Apps, and API endpoints)
# If not set, server falls back to 'admin123' with a security warning.
DASHBOARD_PASSWORD=your_secure_master_password_here

# Finance App Password (optional override; defaults to DASHBOARD_PASSWORD if unset)
FINANCE_PASSWORD=your_secure_finance_password_here

# DietPlan Admin Password (optional override; defaults to DASHBOARD_PASSWORD if unset)
DIETPLAN_ADMIN_PASSWORD=your_dietplan_admin_password_here

# Session Secret (used for signing session cookies, tokens, and HMAC links)
# Recommended: Generate a 64-char hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_session_secret_hex_here

# MongoDB Connection URI (required for FileHub GridFS, QuickNotes, Finance, LearnInvesting, DietPlan)
# Example local: mongodb://127.0.0.1:27017/render-dashboard
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/render-dashboard?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_uri_here

# Scrape.do API Key (used by NewsHunt for newspaper proxy scraping)
SCRAPE_DO_API_KEY=your_scrape_do_token_here

# AI Provider API Keys (optional - can also be configured per-user in NewsHunt / DietPlan UI)
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# YouTube Downloader / Media Tooling (optional path overrides)
YTDLP_PATH=
FFMPEG_PATH=
PYTHON_PATH=
NEWSHUNT_RETENTION_DAYS=3
